; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Darkest Tico"
config/description="Tico Gothic roguelike — design docs in docs/"
run/main_scene="res://scenes/bootstrap/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
TooltipStyler="*res://scripts/autoload/tooltip_styler.gd"

GameState="*res://scripts/autoload/game_state.gd"
SaveService="*res://scripts/autoload/save_service.gd"
Telemetry="*res://scripts/autoload/telemetry.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[gui]

timers/tooltip_delay_sec=0.15
theme/default_font_antialiasing=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"mipmaps/generate": true
}
